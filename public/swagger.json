{
  "openapi": "3.0.0",
  "info": {
    "title": "Techverse Inventory API",
    "version": "1.0.0",
    "description": "Interactive API docs for Techverse's db.json server"
  },
  "servers": [
    { "url": "http://localhost:5000", "description": "Local JSON Server" }
  ],
  "paths": {
    "/parties": {
      "get": {
        "summary": "Get all parties (Customers/Suppliers)",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/items": {
      "get": {
        "summary": "List all inventory items",
        "responses": { "200": { "description": "Success" } }
      },
      "post": {
        "summary": "Add a new item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "price": { "type": "number" },
                  "quantity": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/invoices": {
      "get": {
        "summary": "Retrieve all invoices",
        "responses": { "200": { "description": "Success" } }
      }
    }
  }
}